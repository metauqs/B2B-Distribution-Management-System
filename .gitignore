# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Production build
build/
dist/

# Environment variables (NEVER commit these)
.env
.env.*
*.env
.env.local
.env.*.local
.env.production
.env.development

# Prisma
frontend/prisma/migrations/*.sql
!frontend/prisma/migrations/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
*.pem
Thumbs.db

# Testing
coverage/
.nyc_output

# Logs
logs/
*.log

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# Cache
.eslintcache
.stylelintcache
.cache/

# AI Agents configuration (NEVER commit these)
.agents/
