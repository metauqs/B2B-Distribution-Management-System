# ══════════════════════════════════════════════════════════════════
#  HALAL VEGG SUPPLIES ERP — Environment Variables Template
#  Copy this file to: backend/.env and frontend/.env.local
#  Fill in your actual environment-specific secrets before running.
# ══════════════════════════════════════════════════════════════════

# ─── Database Configuration ───────────────────────────────────────
# Local Development (Docker):
DATABASE_URL="postgresql://sabzi:your_local_password@localhost:5432/sabzi_ledger?schema=public"

# Production (e.g. Neon Serverless PostgreSQL with SSL):
# DATABASE_URL="postgresql://<user>:<password>@<endpoint-id>.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# ─── Backend Server & JWT Authentication ──────────────────────────
PORT=3001
NODE_ENV="development"

# Generate a secure 64-character random hex string:
# Run in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_secure_random_64_character_hex_string_in_production"
JWT_EXPIRES_IN="7d"

# Allowed frontend origin URL for CORS
FRONTEND_URL="http://localhost:3000"
# Production: FRONTEND_URL="https://your-app.vercel.app"

# Optional Initial Admin Bootstrap (Used only when database has 0 employees)
INITIAL_ADMIN_EMPLOYEE_ID="1234"
INITIAL_ADMIN_PASSWORD="change_admin_password_on_first_login"

# ─── Frontend Next.js Configuration ───────────────────────────────
NEXT_PUBLIC_APP_NAME="HALAL VEGG SUPPLIES"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# Production: NEXT_PUBLIC_API_URL="https://your-backend-api.onrender.com/api"

# ─── Local Docker PostgreSQL Setup (Optional) ─────────────────────
POSTGRES_USER=sabzi
POSTGRES_PASSWORD=your_local_dev_password
POSTGRES_DB=sabzi_ledger
PGADMIN_DEFAULT_EMAIL=admin@sabziledger.com
PGADMIN_DEFAULT_PASSWORD=your_local_pgadmin_password
