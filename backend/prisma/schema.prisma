generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id                String             @id @default(cuid())
  name              String
  address           String?
  phone             String?
  type              BranchType         @default(MAIN)
  isActive          Boolean            @default(true)
  createdAt         DateTime @db.Timestamptz(3)           @default(now())
  auditLogs         AuditLog[]
  bankAccounts      BankAccount[]
  broadcastSettings BroadcastSettings?
  cashAccounts      CashAccount[]
  cheques           Cheque[]
  clients           Client[]
  collections       Collection[]
  customerLedgers   CustomerLedger[]
  deliveries        Delivery[]
  drivers           Driver[]
  employees         Employee[]
  expenses          Expense[]
  inventory         Inventory[]
  priceBroadcasts   PriceBroadcast[]
  priceLists        PriceList[]
  purchases         Purchase[]
  purchasePriceHistories PurchasePriceHistory[]
  sales             Sale[]
  stockMovements    StockMovement[]
  supplierLedgers   SupplierLedger[]
  supplierPayments  SupplierPayment[]
  suppliers         Supplier[]
  users             User[]
  vehicles          Vehicle[]
  wastage           Wastage[]
  financialLedgers  FinancialLedger[]

  @@map("branches")
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  password          String
  role              UserRole         @default(SALESMAN)
  phone             String?
  isActive          Boolean          @default(true)
  branchId          String
  lastLoginAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime @db.Timestamptz(3)         @default(now())
  updatedAt         DateTime @db.Timestamptz(3)         @updatedAt
  deletedAt         DateTime? @db.Timestamptz(3)
  auditLogs         AuditLog[]
  priceBroadcasts   PriceBroadcast[] @relation("BroadcastCreator")
  priceListsCreated PriceList[]      @relation("PriceListCreator")
  sales             Sale[]
  expensesCreated   Expense[]        @relation("ExpenseCreator")
  stockMovements    StockMovement[]
  collectionsReceived Collection[]   @relation("CollectionReceivedBy")
  branch            Branch           @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([email])
  @@map("users")
}

model Product {
  id             String              @id @default(cuid())
  name           String              @unique
  urduName       String?
  emoji          String?
  category       ProductCategory     @default(VEGETABLE)
  defaultUnit    Unit                @default(KG)
  minStock       Float               @default(0)
  isActive       Boolean             @default(true)
  availability   ProductAvailability @default(AVAILABLE)
  sortOrder      Int                 @default(0)
  createdAt      DateTime @db.Timestamptz(3)            @default(now())
  updatedAt      DateTime @db.Timestamptz(3)            @updatedAt
  inventory      Inventory[]
  priceItems     PriceItem[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  wastage        Wastage[]
  purchasePriceHistories PurchasePriceHistory[]

  @@index([name])
  @@index([category])
  @@index([availability])
  @@map("products")
}

model Client {
  id                  String               @id @default(cuid())
  clientId            String?              @unique
  name                String
  ownerName           String?
  phone               String?
  whatsapp            String?
  address             String?
  deliveryLocation    String?
  type                ClientType           @default(RETAIL)
  status              ClientStatus         @default(ACTIVE)
  rating              ClientRating         @default(NEW)
  creditLimit         Float                @default(0)
  paymentTerms        Int                  @default(0)
  openingBalance      Float                @default(0)
  currentBalance      Float                @default(0)
  notes               String?
  branchId            String
  createdAt           DateTime @db.Timestamptz(3)             @default(now())
  updatedAt           DateTime @db.Timestamptz(3)             @updatedAt
  deletedAt           DateTime? @db.Timestamptz(3)
  broadcastRecipients BroadcastRecipient[]
  cheques             Cheque[]
  branch              Branch               @relation(fields: [branchId], references: [id])
  collections         Collection[]
  ledgers             CustomerLedger[]
  deliveries          Delivery[]
  sales               Sale[]

  @@index([branchId])
  @@index([branchId, deletedAt])
  @@index([name])
  @@index([rating])
  @@map("clients")
}

model Supplier {
  id               String            @id @default(cuid())
  name             String
  phone            String?
  address          String?
  openingBalance   Float             @default(0)
  status           SupplierStatus    @default(ACTIVE)
  branchId         String
  createdAt        DateTime @db.Timestamptz(3)          @default(now())
  updatedAt        DateTime @db.Timestamptz(3)          @updatedAt
  deletedAt        DateTime? @db.Timestamptz(3)
  cheques          Cheque[]
  purchases        Purchase[]
  ledgers          SupplierLedger[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]
  purchasePriceHistories PurchasePriceHistory[]
  branch           Branch            @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([name])
  @@map("suppliers")
}

model Sale {
  id                  String            @id @default(cuid())
  invoiceNo           String
  clientId            String
  date                DateTime @db.Timestamptz(3)          @default(now())
  subtotal            Float             @default(0)
  discount            Float             @default(0)
  deliveryCharge      Float             @default(0)
  previousBalance     Float             @default(0)
  previousBalanceDate DateTime? @db.Timestamptz(3)
  total               Float             @default(0)
  paid                Float             @default(0)
  balance             Float             @default(0)
  paymentMode         SalePaymentMode   @default(CREDIT)
  status              TransactionStatus @default(PENDING)
  deliveryStatus      DeliveryStatus    @default(PENDING)
  notes               String?
  failureReason       String?
  branchId            String
  userId              String?
  createdAt           DateTime @db.Timestamptz(3)          @default(now())
  updatedAt           DateTime @db.Timestamptz(3)          @updatedAt
  deletedAt           DateTime? @db.Timestamptz(3)
  employeeId          String?
  deliveryDate        DateTime? @db.Timestamptz(3)
  deliveryTime        String?
  isLocked            Boolean           @default(false)
  deliveries          Delivery[]
  items               SaleItem[]
  collectionAllocations CollectionAllocation[]
  branch              Branch            @relation(fields: [branchId], references: [id])
  client              Client            @relation(fields: [clientId], references: [id])
  user                User?             @relation(fields: [userId], references: [id])
  employee            Employee?         @relation(fields: [employeeId], references: [id])

  @@unique([clientId, invoiceNo])
  @@index([clientId])
  @@index([branchId])
  @@index([branchId, deletedAt])
  @@index([date])
  @@index([status])
  @@index([invoiceNo])
  @@index([employeeId])
  @@index([clientId, status, deletedAt])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String?
  itemName  String
  qty       Float
  unit      Unit     @default(KG)
  rate      Float
  amount    Float
  costPrice Float    @default(0)
  returnedQty Float   @default(0)
  returnReason String?
  product   Product? @relation(fields: [productId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Purchase {
  id               String            @id @default(cuid())
  supplierId       String
  date             DateTime @db.Timestamptz(3)          @default(now())
  subtotal         Float             @default(0)
  transportCost    Float             @default(0)
  total            Float             @default(0)
  paid             Float             @default(0)
  balance          Float             @default(0)
  status           TransactionStatus @default(PENDING)
  notes            String?
  branchId         String
  createdAt        DateTime @db.Timestamptz(3)          @default(now())
  updatedAt        DateTime @db.Timestamptz(3)          @updatedAt
  deletedAt        DateTime? @db.Timestamptz(3)
  items            PurchaseItem[]
  branch           Branch            @relation(fields: [branchId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  supplierPayments SupplierPayment[]
  purchasePriceHistories PurchasePriceHistory[]

  @@index([supplierId])
  @@index([branchId])
  @@index([branchId, deletedAt])
  @@index([date])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String?
  itemName   String
  qty        Float
  unit       Unit     @default(KG)
  rate       Float
  amount     Float
  product    Product? @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model SupplierPayment {
  id            String        @id @default(cuid())
  supplierId    String
  purchaseId    String?
  amount        Float
  method        PaymentMethod @default(CASH)
  cashAccountId String?
  bankAccountId String?
  reference     String?
  notes         String?
  date          DateTime @db.Timestamptz(3)      @default(now())
  branchId      String
  createdAt     DateTime @db.Timestamptz(3)      @default(now())
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  branch        Branch        @relation(fields: [branchId], references: [id])
  cashAccount   CashAccount?  @relation(fields: [cashAccountId], references: [id])
  purchase      Purchase?     @relation(fields: [purchaseId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([purchaseId])
  @@index([branchId])
  @@index([cashAccountId])
  @@index([bankAccountId])
  @@map("supplier_payments")
}

model Collection {
  id               String        @id @default(cuid())
  clientId         String
  amount           Float
  method           PaymentMethod @default(CASH)
  cashAccountId    String?
  bankAccountId    String?
  receivedByUserId String?
  remainingBalance Float?
  date             DateTime      @default(now()) @db.Timestamptz(3)
  reference        String?
  notes            String?
  branchId         String
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  deletedAt        DateTime?     @db.Timestamptz(3)
  allocations      CollectionAllocation[]
  bankAccount      BankAccount?  @relation(fields: [bankAccountId], references: [id])
  branch           Branch        @relation(fields: [branchId], references: [id])
  cashAccount      CashAccount?  @relation(fields: [cashAccountId], references: [id])
  client           Client        @relation(fields: [clientId], references: [id])
  receivedByUser   User?         @relation("CollectionReceivedBy", fields: [receivedByUserId], references: [id])

  @@index([clientId])
  @@index([branchId])
  @@index([branchId, deletedAt])
  @@index([date])
  @@index([cashAccountId])
  @@index([bankAccountId])
  @@index([receivedByUserId])
  @@index([clientId, deletedAt])
  @@map("collections")
}

model CollectionAllocation {
  id              String      @id @default(cuid())
  collectionId    String
  saleId          String
  allocatedAmount Float
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  collection      Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sale            Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([saleId])
  @@map("collection_allocations")
}

model Expense {
  id            String          @id @default(cuid())
  reference     String?
  category      ExpenseCategory
  categoryRefId String?
  description   String?
  amount        Float
  date          DateTime        @db.Timestamptz(3) @default(now())
  vehicleId     String?
  employeeId    String?
  supplierId    String?
  createdById   String?
  paidBy        PaymentMethod?
  cashAccountId String?
  bankAccountId String?
  notes         String?
  branchId      String
  createdAt     DateTime        @db.Timestamptz(3) @default(now())
  deletedAt     DateTime?       @db.Timestamptz(3)
  bankAccount   BankAccount?    @relation(fields: [bankAccountId], references: [id])
  branch        Branch          @relation(fields: [branchId], references: [id])
  cashAccount   CashAccount?    @relation(fields: [cashAccountId], references: [id])
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id])
  employee      Employee?       @relation(fields: [employeeId], references: [id])
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  createdBy     User?           @relation("ExpenseCreator", fields: [createdById], references: [id])
  categoryRef   ExpenseCategoryRef? @relation(fields: [categoryRefId], references: [id])

  @@index([branchId])
  @@index([date])
  @@index([category])
  @@index([categoryRefId])
  @@index([vehicleId])
  @@index([employeeId])
  @@index([supplierId])
  @@index([createdById])
  @@index([cashAccountId])
  @@index([bankAccountId])
  @@map("expenses")
}

model ExpenseCategoryRef {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expenses  Expense[]

  @@map("expense_categories")
}

model Wastage {
  id        String   @id @default(cuid())
  productId String?
  itemName  String
  qty       Float
  unit      Unit     @default(KG)
  reason    String?
  date      DateTime @db.Timestamptz(3) @default(now())
  branchId  String
  createdAt DateTime @db.Timestamptz(3) @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])

  @@index([branchId])
  @@index([date])
  @@index([productId])
  @@map("wastages")
}

model Inventory {
  id               String    @id @default(cuid())
  productId        String
  branchId         String
  qty              Float     @default(0)
  reservedQty      Float     @default(0)
  minStock         Float     @default(0)
  avgCost          Float     @default(0)
  currentBuyPrice  Float     @default(0)
  previousBuyPrice Float     @default(0)
  lastPurchaseDate DateTime? @db.Timestamptz(3)
  lastPurchaseQty  Float     @default(0)
  updatedAt        DateTime  @db.Timestamptz(3) @updatedAt
  branch           Branch    @relation(fields: [branchId], references: [id])
  product          Product   @relation(fields: [productId], references: [id])

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("inventory")
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  branchId      String
  type          StockMovementType
  qty           Float
  previousStock Float             @default(0)
  newStock      Float             @default(0)
  refType       String?
  refId         String?
  note          String?
  userId        String?
  date          DateTime          @db.Timestamptz(3) @default(now())
  createdAt     DateTime          @db.Timestamptz(3) @default(now())
  branch        Branch            @relation(fields: [branchId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  user          User?             @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([branchId])
  @@index([date])
  @@index([userId])
  @@map("stock_movements")
}

model PurchasePriceHistory {
  id         String    @id @default(cuid())
  productId  String
  branchId   String
  purchaseId String?
  supplierId String?
  buyPrice   Float
  qty        Float
  date       DateTime  @db.Timestamptz(3) @default(now())
  createdAt  DateTime  @db.Timestamptz(3) @default(now())
  branch     Branch    @relation(fields: [branchId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([branchId])
  @@index([date])
  @@map("purchase_price_histories")
}

model PriceList {
  id          String      @id @default(cuid())
  date        DateTime    @db.Timestamptz(3)
  branchId    String
  createdById String?
  isActive    Boolean     @default(true)
  notes       String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  items       PriceItem[]
  branch      Branch      @relation(fields: [branchId], references: [id])
  createdBy   User?       @relation("PriceListCreator", fields: [createdById], references: [id])

  @@unique([date, branchId])
  @@index([branchId])
  @@index([date])
  @@map("price_lists")
}

model PriceItem {
  id          String    @id @default(cuid())
  priceListId String
  productId   String?
  itemName    String
  unit        Unit      @default(KG)
  buyRate     Float     @default(0)
  sellRate    Float     @default(0)
  notes       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])

  @@unique([priceListId, itemName])
  @@unique([priceListId, productId])
  @@index([priceListId])
  @@index([productId])
  @@map("price_items")
}

model Delivery {
  id          String         @id @default(cuid())
  saleId      String
  clientId    String
  vehicleId   String?
  driverId    String?
  zone        String?
  status      DeliveryStatus @default(PENDING)
  notes       String?
  failureReason String?
  deliveredAt DateTime? @db.Timestamptz(3)
  returnedAt  DateTime? @db.Timestamptz(3)
  date        DateTime @db.Timestamptz(3)       @default(now())
  branchId    String
  createdAt   DateTime @db.Timestamptz(3)       @default(now())
  updatedAt   DateTime @db.Timestamptz(3)       @updatedAt
  employeeId  String?
  scheduledTime String?
  branch      Branch         @relation(fields: [branchId], references: [id])
  client      Client         @relation(fields: [clientId], references: [id])
  driver      Driver?        @relation(fields: [driverId], references: [id])
  sale        Sale           @relation(fields: [saleId], references: [id])
  vehicle     Vehicle?       @relation(fields: [vehicleId], references: [id])
  employee    Employee?      @relation(fields: [employeeId], references: [id])

  @@index([saleId])
  @@index([clientId])
  @@index([branchId])
  @@index([branchId, status])
  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
  @@index([employeeId])
  @@map("deliveries")
}

model Vehicle {
  id         String      @id @default(cuid())
  plateNo    String      @unique
  type       VehicleType @default(TRUCK)
  driverId   String?
  isActive   Boolean     @default(true)
  branchId   String
  createdAt  DateTime @db.Timestamptz(3)    @default(now())
  deliveries Delivery[]
  expenses   Expense[]
  branch     Branch      @relation(fields: [branchId], references: [id])
  driver     Driver?     @relation(fields: [driverId], references: [id])

  @@index([branchId])
  @@index([driverId])
  @@map("vehicles")
}

model Driver {
  id         String     @id @default(cuid())
  name       String
  phone      String?
  licenceNo  String?
  isActive   Boolean    @default(true)
  branchId   String
  createdAt  DateTime @db.Timestamptz(3)   @default(now())
  deliveries Delivery[]
  branch     Branch     @relation(fields: [branchId], references: [id])
  vehicles   Vehicle[]

  @@index([branchId])
  @@map("drivers")
}

model Employee {
  id             String          @id @default(cuid())
  employeeId     String?         @unique
  password       String?
  name           String
  role           EmployeeRole    @default(DELIVERY_STAFF)
  phone          String?
  salary         Float           @default(0)
  joiningDate    DateTime @db.Timestamptz(3)        @default(now())
  isActive       Boolean         @default(true)
  branchId       String
  fatherName     String?
  cnic           String?
  address        String?
  whatsapp       String?
  email          String?
  paymentStructure String?
  notes          String?
  photoUrl       String?
  createdAt      DateTime @db.Timestamptz(3)        @default(now())
  attendance     Attendance[]
  branch         Branch          @relation(fields: [branchId], references: [id])
  salaryPayments SalaryPayment[]
  sales          Sale[]
  deliveries     Delivery[]
  expenses       Expense[]

  @@index([branchId])
  @@index([employeeId])
  @@map("employees")
}

model SalaryPayment {
  id            String        @id @default(cuid())
  employeeId    String
  month         String
  amount        Float
  method        PaymentMethod @default(CASH)
  cashAccountId String?
  bankAccountId String?
  paidOn        DateTime @db.Timestamptz(3)      @default(now())
  notes         String?
  createdAt     DateTime @db.Timestamptz(3)      @default(now())
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  cashAccount   CashAccount?  @relation(fields: [cashAccountId], references: [id])
  employee      Employee      @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([month])
  @@map("salary_payments")
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime @db.Timestamptz(3)
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime @db.Timestamptz(3)         @default(now())
  employee   Employee         @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

model CashAccount {
  id               String            @id @default(cuid())
  name             String            @default("Main Cash")
  balance          Float             @default(0)
  branchId         String
  createdAt        DateTime @db.Timestamptz(3)          @default(now())
  updatedAt        DateTime @db.Timestamptz(3)          @updatedAt
  branch           Branch            @relation(fields: [branchId], references: [id])
  collections      Collection[]
  expenses         Expense[]
  salaryPayments   SalaryPayment[]
  supplierPayments SupplierPayment[]

  @@index([branchId])
  @@map("cash_accounts")
}

model BankAccount {
  id               String            @id @default(cuid())
  name             String
  accountNo        String?
  bankName         String?
  balance          Float             @default(0)
  branchId         String
  createdAt        DateTime @db.Timestamptz(3)          @default(now())
  updatedAt        DateTime @db.Timestamptz(3)          @updatedAt
  branch           Branch            @relation(fields: [branchId], references: [id])
  cheques          Cheque[]
  collections      Collection[]
  expenses         Expense[]
  salaryPayments   SalaryPayment[]
  supplierPayments SupplierPayment[]

  @@index([branchId])
  @@map("bank_accounts")
}

model Cheque {
  id            String       @id @default(cuid())
  type          ChequeType
  chequeNo      String?
  amount        Float
  dueDate       DateTime @db.Timestamptz(3)
  status        ChequeStatus @default(PENDING)
  clientId      String?
  supplierId    String?
  bankAccountId String?
  notes         String?
  branchId      String
  createdAt     DateTime @db.Timestamptz(3)     @default(now())
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  branch        Branch       @relation(fields: [branchId], references: [id])
  client        Client?      @relation(fields: [clientId], references: [id])
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])

  @@index([dueDate])
  @@index([status])
  @@index([clientId])
  @@index([supplierId])
  @@index([bankAccountId])
  @@index([branchId])
  @@map("cheques")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  branchId  String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @db.Timestamptz(3) @default(now())
  branch    Branch?  @relation(fields: [branchId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([branchId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model CustomerLedger {
  id          String                @id @default(cuid())
  clientId    String
  type        LedgerTransactionType
  date        DateTime @db.Timestamptz(3)              @default(now())
  referenceId String?
  referenceNo String?
  description String?
  debit       Float                 @default(0)
  credit      Float                 @default(0)
  balance     Float                 @default(0)
  branchId    String
  createdAt   DateTime @db.Timestamptz(3)              @default(now())
  updatedAt   DateTime @db.Timestamptz(3)              @updatedAt
  branch      Branch                @relation(fields: [branchId], references: [id])
  client      Client                @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([branchId])
  @@index([date])
  @@index([clientId, date])
  @@map("customer_ledger")
}

model SupplierLedger {
  id          String                @id @default(cuid())
  supplierId  String
  type        LedgerTransactionType
  date        DateTime @db.Timestamptz(3)              @default(now())
  referenceId String?
  referenceNo String?
  description String?
  debit       Float                 @default(0)
  credit      Float                 @default(0)
  balance     Float                 @default(0)
  branchId    String
  createdAt   DateTime @db.Timestamptz(3)              @default(now())
  updatedAt   DateTime @db.Timestamptz(3)              @updatedAt
  branch      Branch                @relation(fields: [branchId], references: [id])
  supplier    Supplier              @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([branchId])
  @@index([date])
  @@map("supplier_ledger")
}

model PriceBroadcast {
  id               String               @id @default(cuid())
  createdAt        DateTime @db.Timestamptz(3)             @default(now())
  sentByUserId     String
  priceListDate    DateTime @db.Timestamptz(3)
  imageUrl         String
  imageGeneratedAt DateTime @db.Timestamptz(3)             @default(now())
  imageVersion     Int                  @default(1)
  totalRecipients  Int                  @default(0)
  successCount     Int                  @default(0)
  failureCount     Int                  @default(0)
  status           BroadcastStatus      @default(PENDING)
  branchId         String
  recipients       BroadcastRecipient[]
  branch           Branch               @relation(fields: [branchId], references: [id])
  sentByUser       User                 @relation("BroadcastCreator", fields: [sentByUserId], references: [id])

  @@index([branchId])
  @@index([sentByUserId])
  @@index([priceListDate])
  @@map("price_broadcasts")
}

model BroadcastRecipient {
  id             String                  @id @default(cuid())
  broadcastId    String
  clientId       String
  whatsappNumber String
  status         BroadcastDeliveryStatus @default(PENDING)
  attempts       Int                     @default(0)
  lastAttemptAt  DateTime? @db.Timestamptz(3)
  errorMessage   String?
  updatedAt      DateTime @db.Timestamptz(3)                @updatedAt
  broadcast      PriceBroadcast          @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  client         Client                  @relation(fields: [clientId], references: [id])

  @@unique([broadcastId, clientId])
  @@index([clientId])
  @@index([status])
  @@map("broadcast_recipients")
}

model BroadcastSettings {
  id                   String   @id @default(cuid())
  branchId             String   @unique
  companyLogo          String?
  companyName          String   @default("HALAL VEGG SUPPLIES")
  defaultGreeting      String   @default("Assalam-o-Alaikum {{ClientName}}\n\nPlease find today's fresh fruit & vegetable rates.\n\nThank you for choosing HALAL VEGG SUPPLIES.")
  defaultFooter        String?
  defaultBroadcastTime String   @default("09:00")
  defaultImageTemplate String   @default("default")
  updatedAt            DateTime @db.Timestamptz(3) @updatedAt
  branch               Branch   @relation(fields: [branchId], references: [id])

  @@map("broadcast_settings")
}

model FinancialLedger {
  id              String                   @id @default(cuid())
  branchId        String
  date            DateTime                 @default(now()) @db.Timestamptz(3)
  transactionType String
  entryType       String                   // DEBIT or CREDIT
  accountCategory String                   // REVENUE, COGS, ASSET_RECEIVABLE, ASSET_CASH, ASSET_INVENTORY, LIABILITY_PAYABLE, EXPENSE_OPERATING, EXPENSE_WASTAGE, DIRECT_COST
  accountName     String
  debit           Float                    @default(0)
  credit          Float                    @default(0)
  referenceType   String?                  // sale, purchase, collection, expense, wastage, adjustment
  referenceId     String?
  referenceNo     String?
  entityId        String?                  // clientId, supplierId, productId
  entityType      String?                  // client, supplier, product
  // Typed enum columns (normalized — to replace string columns after backfill verification)
  txType          FinancialTransactionType?
  entType         FinancialEntryType?
  acctCategory    AccountCategory?
  entEntityType   FinancialEntityType?
  notes           String?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  branch          Branch                   @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([date])
  @@index([accountCategory])
  @@index([referenceType, referenceId])
  @@index([txType])
  @@map("financial_ledger")
}

